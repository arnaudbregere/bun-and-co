{
  "name": "bun-and-co",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "description": "Borne de commande tactile pour l'enseigne Bun & Co",
  "license": "MIT",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "contrasts": "node scripts/verify-contrasts.mjs",
    "layer-order": "node scripts/verify-layer-order.mjs",
    "catalogue-route": "node scripts/verify-catalogue-route.mjs",
    "component-levels": "node scripts/verify-component-levels.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "happy-dom": "^21.0.4",
    "nuxt": "4.7.0",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "5.9.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  }
}
